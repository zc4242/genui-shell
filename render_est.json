{"title": "H3 渲染估时器", "components": [{"type": "slider", "id": "p", "label": "分辨率 (MP)", "min": 0.4, "max": 4.0, "step": 0.1, "value": 1.0}, {"type": "slider", "id": "r", "label": "采样步数", "min": 4, "max": 30, "step": 1, "value": 8}, {"type": "slider", "id": "y", "label": "视频段时长 (秒)", "min": 2, "max": 30, "step": 1, "value": 8}, {"type": "slider", "id": "m", "label": "参考图/条件图数量", "min": 0, "max": 4, "step": 1, "value": 0}, {"type": "stat", "id": "total_time", "label": "预估渲染时间 (分钟)", "formula": "(() => { const penalty = (p > 1.0 || r > 10 || m >= 2) ? 2.2 : 1.0; const total = (p / 1.0) * (r / 8) * (y / 8) * 7 * penalty; return total.toFixed(2); })()", "format": "minutes"}, {"type": "chart", "id": "cumulative_time", "label": "逐秒视频长度的总耗时 (分钟)", "formula": "const penalty=(p>1.0||r>10||m>=2)?2.2:1.0;const rate=(p/1.0)*(r/8)*(1/8)*7*penalty;const arr=[];for(let s=1;s<=Math.round(y);s++)arr.push(+(s*rate).toFixed(2));return arr;"}, {"type": "button", "id": "btn_estimate", "label": "开始估算", "action": "estimate_render"}]}