{"title": "H3 渲染估时器 v2", "components": [{"type": "select", "id": "model", "label": "模型", "value": "h3", "options": [{"value": "h3", "label": "H3 (I2VA/FL2VA)"}, {"value": "h3_ref2va", "label": "H3 Ref2VA (吃显存)"}, {"value": "scail2", "label": "SCAIL-2 换动作"}, {"value": "i2v", "label": "Grok/其他 I2V"}]}, {"type": "select", "id": "gpu", "label": "GPU", "value": "4090", "options": [{"value": "4090", "label": "RTX 4090 24G (局域网)"}, {"value": "mac", "label": "Mac 本机 (mlx)"}]}, {"type": "slider", "id": "p", "label": "分辨率 (MP)", "min": 0.4, "max": 4.0, "step": 0.1, "value": 1.0}, {"type": "slider", "id": "r", "label": "采样步数", "min": 4, "max": 30, "step": 1, "value": 8}, {"type": "slider", "id": "y", "label": "视频段时长 (秒)", "min": 2, "max": 30, "step": 1, "value": 8}, {"type": "slider", "id": "m", "label": "参考图/条件图数量", "min": 0, "max": 4, "step": 1, "value": 0}, {"type": "stat", "id": "est", "label": "预估渲染时间", "formula": "gpu==='mac' ? (p/1.0)*(r/8)*(y/8)*35 : (p/1.0)*(r/8)*(y/8)*7 * (model==='h3_ref2va'?1.3:1) * ((p>1.0||r>10||m>=2)?2.2:1)", "format": "minutes"}, {"type": "chart", "id": "cum", "label": "逐秒视频长度的耗时 (分钟)", "formula": "const k=(p/1.0)*(r/8)*(1/8)*(gpu==='mac'?35:7)*(model==='h3_ref2va'?1.3:1)*((p>1.0||r>10||m>=2)?2.2:1);const a=[];for(let s=1;s<=Math.round(y);s++)a.push(+(s*k).toFixed(2));return a"}, {"type": "button", "id": "go", "label": "估计渲染", "action": "estimate_render"}]}